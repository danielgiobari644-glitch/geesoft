rules_version = '2';

// ============================================================
// GeeSoft — Firestore Security Rules
// ============================================================
// ANYONE can READ the portfolio content (that is what makes the
// public website work for every visitor, signed in or not).
//
// ONLY the authorised administrator can WRITE anything, and only
// the administrator can read the private admin collections.
//
// The admin page itself lives at the /admin path. Hiding that path
// is NOT the security boundary — these rules are. Even if someone
// finds /admin, signs up, or calls Firestore directly from a
// console, they cannot change a single field unless their UID is
// in the /admins allow-list below.
// ============================================================
//
// ONE-TIME SETUP in the Firebase console (project "geesoft10"):
//   1. Authentication → Sign-in method → enable "Email/Password".
//      Leave every other provider disabled.
//   2. Authentication → Users → "Add user" → your admin email and a
//      strong password. (Created in the console — the password never
//      touches this repo or Firestore.)
//   3. Copy that user's UID.
//   4. Firestore → collection "admins" → document ID = that UID →
//      field: role = "owner".
//   5. Firestore → Rules → paste this file → Publish.
//
// To revoke admin access later, delete that document in /admins.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    // True only for a signed-in user whose UID is in the allow-list.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'password'
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---------- PUBLIC PORTFOLIO CONTENT ----------
    // Read: open to the whole world (the public site needs it).
    // Write: administrator only.

    // Hero, Introduction, Skills/Projects section text,
    // Contact details, Site settings, navigation labels.
    match /content/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /skills/{skillId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ---------- PRIVATE ADMIN DATA ----------
    // Not public. An admin may read only their own allow-list entry.
    // Nobody can write it from a client — membership is granted
    // exclusively from the Firebase console.
    match /admins/{uid} {
      allow read:   if request.auth != null && request.auth.uid == uid;
      allow write:  if false;
    }

    // ---------- EVERYTHING ELSE ----------
    // Closed by default. Any collection not named above is denied,
    // for reads and writes, to everyone.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
