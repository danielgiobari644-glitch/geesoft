rules_version = '2';

// ============================================================
// Giobari Daniel — Portfolio · Firestore security rules
// ------------------------------------------------------------
// Public visitors:  read published content only, may submit a
//                   contact message (create-only, validated).
// Admin (signed in): full read/write on portfolio content.
//
// Deploy: Firebase Console → Firestore Database → Rules → paste
// this file → Publish.  (Or: firebase deploy --only firestore:rules)
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null;
    }

    function validMessage() {
      return request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && (!('phone' in request.resource.data) || request.resource.data.phone is string)
        && request.resource.data.phone.size() <= 40
        && request.resource.data.read == false
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'message', 'read', 'createdAt']);
    }

    // Site-wide settings (single document: settings/general)
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Portfolio projects
    match /projects/{projectId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Services
    match /services/{serviceId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Skills
    match /skills/{skillId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Testimonials
    match /testimonials/{testimonialId} {
      allow read: if isAdmin() || resource.data.published == true;
      allow create, update, delete: if isAdmin();
    }

    // Contact messages: anyone may send one; only the admin can read,
    // mark read/unread or delete them.
    match /messages/{messageId} {
      allow create: if validMessage();
      allow read, update, delete: if isAdmin();
    }
  }
}
